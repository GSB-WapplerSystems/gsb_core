plugin {
  tx_dpnglossary {
    settings {
      termWraps {
        abbreviation {
          typolink >
        }

        acronym < abbreviation

        definition {
          typolink {
            section.field = url_segment

            parameter.override < plugin.tx_dpnglossary.settings.detailPage
            parameter.override.if {
              value = 0
              isGreaterThan < plugin.tx_dpnglossary.settings.detailPage
            }

            override >
            parameter.stdWrap.override >
            additionalParams >

            ATagParams {
              dataWrap = title="{FIELD:tooltiptext // FIELD:name}" class="dpnglossary link" role="button"
              dataWrap.override < .dataWrap
            }
          }

          dataWrap (
            <dfn
              data-glossary-title="{FIELD:descriptions|0|meaning}"
              data-glossary-text="{FIELD:descriptions|0|text}"
              data-bs-target="#glossary-definition-modal"
              data-bs-toggle="modal"
              title="{FIELD:tooltiptext // FIELD:name}"
              lang="{FIELD:term_lang}">|</dfn>
          )
          dataWrap.override < .dataWrap
        }
      }
    }
  }
}

[feature("ITZBUNDPHP-3327") == false]
plugin.tx_dpnglossary.settings.disableParser = 1
module.tx_dpnglossary.settings.disableParser = 1
[global]
