plugin {
  tx_dpnglossary {
    settings {
      termWraps {
        abbreviation {
          typolink >
        }

        acronym < abbreviation

        definition >
        definition = FLUIDTEMPLATE
        definition {
          file = EXT:gsb_core/Resources/Extensions/dpn-glossary/Private/Templates/Term/Definition.html

          variables {
            title = TEXT
            title.data = field: tooltiptext // field: name
            detailPage = TEXT
            detailPage.value = {$plugin.tx_dpnglossary.settings.detailPage}
            overviewLink = TEXT
            overviewLink {
              typolink {
                parameter < plugin.tx_dpnglossary.settings.detailPage
                returnLast = url
                additionalParams = &tx_dpnglossary_glossary[action]=list&tx_dpnglossary_glossary[controller]=Term&tx_dpnglossary_glossary[currentCharacter]=
                additionalParams.stdWrap.append = TEXT
                additionalParams.stdWrap.append {
                  field = name
                  substring = 0,1
                  case = upper
                }
                section.stdWrap.append = TEXT
                section.stdWrap.append {
                  field = url_segment
                  htmlSpecialChars = 1
                }
              }
            }
          }
        }
      }
    }

    view {
      templateRootPaths.10 = EXT:gsb_core/Resources/Extensions/dpn-glossary/Private/Templates/
      partialRootPaths.10 = EXT:gsb_core/Resources/Extensions/dpn-glossary/Private/Partials/
    }
  }
}
