plugin {
  tx_dpnglossary {
    settings {
      termWraps {
        abbreviation {
          typolink >
        }

        acronym < abbreviation

        definition >
        definition = FLUIDTEMPLATE
        definition {
          file = EXT:gsb_core/Resources/Extensions/dpn-glossary/Private/Partials/Term/Definition.html

          variables {
            title = TEXT
            title.data = field: tooltiptext // field: name
            detailLink = TEXT
            detailLink {
              typolink {
                section.field = url_segment
                parameter < plugin.tx_dpnglossary.settings.detailPage
                returnLast = url
              }
            }
          }
        }
      }
    }

    view {
      templateRootPaths.10 = EXT:gsb_core/Resources/Extensions/dpn-glossary/Private/Templates/
      partialRootPaths.10 = EXT:gsb_core/Resources/Extensions/dpn-glossary/Private/Partials/
    }
  }
}

[feature("ITZBUNDPHP-3327") == false]
plugin.tx_dpnglossary.settings.disableParser = 1
module.tx_dpnglossary.settings.disableParser = 1
[global]
