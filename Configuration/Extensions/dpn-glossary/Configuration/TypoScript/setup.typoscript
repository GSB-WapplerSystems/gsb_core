plugin {
  tx_dpnglossary {
    settings {
      termWraps {
        abbreviation {
          typolink >
        }

        acronym {
          typolink >
        }

        definition {
          dataWrap (
            <dfn
              data-glossary-title="{FIELD:descriptions|0|meaning}"
              data-glossary-text="{FIELD:descriptions|0|text}"
              data-bs-target="#glossary-definition-modal"
              data-bs-toggle="modal"
              title="{FIELD:tooltiptext // FIELD:name}"
              lang="{FIELD:term_lang}">|</dfn>
          )
          dataWrap.override < .dataWrap
        }
      }
    }
  }
}

[feature("ITZBUNDPHP-3327") == false]
plugin.tx_dpnglossary.settings.disableParser = 1
module.tx_dpnglossary.settings.disableParser = 1
[global]
