tt_content {
    gsb_imagemap = FLUIDTEMPLATE
    gsb_imagemap {
        templateRootPaths {
            200 = EXT:gsb_core/Resources/Private/Templates/Content/
            300 = {$gsb_core.content.view.templateRootPath}
        }

        partialRootPaths {
            200 = EXT:gsb_core/Resources/Extensions/fluid_styled_content/Private/Partials/
            300 = {$gsb_core.content.view.partialRootPath}
        }

        templateName = ImageMap
        dataProcessing {
            10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
            10 {
                references {
                    fieldName = image
                    table = tt_content
                }
                as = image
            }

            # ToDo Does it make sense to replace it with a custom DataProcessor (and an extbase model)?
            20 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
            20 {
                table = tx_gsbcore_hotspot
                where.dataWrap = tx_gsbcore_hotspot.imagemap = {FIELD:uid}
                as = hotspots
            }
        }
    }
}
