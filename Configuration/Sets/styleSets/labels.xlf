			<trans-unit id="settings.logos.display-brand-topline">
				<source>Show page topline</source>
			</trans-unit>
			<trans-unit id="settings.description.logos.display-brand-topline">
				<source>Displays the text "An official website of the Federal Republic of Germany" as topline of the website.</source>
			</trans-unit>
			<!-- Favicons -->
			<trans-unit id="settings.favicons.favicon-96x96-png">
				<source>Favicon 96x96 PNG</source>
			</trans-unit>
			<trans-unit id="settings.description.favicons.favicon-96x96-png">
				<source>The PNG file must be square and have a size of 96x96 pixels. Filename must be "favicon-96x96.png".</source>
			</trans-unit>
			<trans-unit id="settings.favicons.faviconIco">
				<source>Favicon ICO</source>
			</trans-unit>
			<trans-unit id="settings.description.favicons.faviconIco">
				<source>The classic ICO file must be square and have a size of 48x48 pixels. Filename must be "favicon.ico".</source>
			</trans-unit>
			<trans-unit id="settings.favicons.faviconSvg">
				<source>Favicon SVG</source>
			</trans-unit>
			<trans-unit id="settings.description.favicons.faviconSvg">
