			<trans-unit id="settings.colors.background.gsb-background-color-2.label">
				<source>Color Name #2</source>
			</trans-unit>
			<trans-unit id="settings.description.colors.background.gsb-background-color-2.label">
				<source>Enter the color name that indicates the purpose of use. Example: "Warning" instead of "Red".</source>
			</trans-unit>
