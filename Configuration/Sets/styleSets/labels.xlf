		<header />
		<body>
			<trans-unit id="label">
				<source>GSB Style</source>
			</trans-unit>
			<!-- Style Settings Categories -->
			<trans-unit id="categories.GSB.style.colors">
				<source>Colors</source>
			</trans-unit>
			<trans-unit id="categories.GSB.style.colors.background">
				<source>Background Colors</source>
			</trans-unit>
			<trans-unit id="categories.GSB.style.colors.colorGeneral">
				<source>Color</source>
			</trans-unit>
			<trans-unit id="categories.GSB.style.logos">
				<source>Logos</source>
			</trans-unit>
			<trans-unit id="categories.GSB.style.favicons">
				<source>Favicons</source>
			</trans-unit>
			<trans-unit id="categories.GSB.style.fonts">
				<source>Fonts</source>
			</trans-unit>
			<!-- Category Descriptions -->
			<trans-unit id="categories.description.GSB.style.colors.background">
				<source>Define up to six background colors for the website that are then available in content elements. Important: Each color needs its own color name that indicates the purpose of use.</source>
			</trans-unit>
			<trans-unit id="categories.description.GSB.style.colors.colorGeneral">
				<source>The color values can be exchanged at this point to adjust the colors of buttons or links, for example. Important: Please ensure sufficient contrast.</source>
			</trans-unit>
			<trans-unit id="categories.description.GSB.style.favicons">
				<source>Please use the service at: https://realfavicongenerator.net/ (This service is free and copyright-free). For this you only need a 512x512 large favicon PNG image and have it processed by this service. Download the generated files and add them e.g. under /fileadmin/Favicons/. Then you can link the corresponding files here again to exchange your favicon. Of course you can also create all files manually. The file names and image sizes must be maintained.</source>
			</trans-unit>
			<trans-unit id="categories.description.GSB.style.fonts">
				<source>The following fields can be used to use individual fonts in the frontend.</source>
			</trans-unit>
			<!-- Background Colors -->
			<trans-unit id="settings.colors.background.gsb-background-color-1.color">
				<source>Color #1</source>
			</trans-unit>
			<trans-unit id="settings.description.colors.background.gsb-background-color-1.color">
				<source>Enter a hex value (e.g. #000 or #FFFFFF) or select via the color picker.</source>
			</trans-unit>
			<trans-unit id="settings.colors.background.gsb-background-color-1.label">
				<source>Color Name #1</source>
			</trans-unit>
			<trans-unit id="settings.description.colors.background.gsb-background-color-1.label">
