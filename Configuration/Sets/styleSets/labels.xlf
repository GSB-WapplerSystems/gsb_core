			</trans-unit>
			<!-- Color General -->
			<trans-unit id="settings.colors.colorGeneral.gsb-color-primary">
				<source>Primary Color Value</source>
			</trans-unit>
			<trans-unit id="settings.description.colors.colorGeneral.gsb-color-primary">
				<source>e.g. CTA Button.</source>
			</trans-unit>
			<trans-unit id="settings.colors.colorGeneral.gsb-color-secondary">
