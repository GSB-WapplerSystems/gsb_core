{
  "name": "itzbund/gsb-core",
  "description": "Core functionality and base configuration for Government Site Builder (GSB) 11. This is part of the Government Site Builder (GSB) 11. The GSB 11 is a measure of the Dienstekonsolidierung Bund (DKB) of the Federal Ministry of the Interior and for Homeland (BMI) and is carried out on behalf of the Information Technology Center of the Federal Government (ITZBund).",
  "license": [
    "GPL-3.0-or-later"
  ],
  "type": "typo3-cms-extension",
  "authors": [
    {
      "name": "Kai Ole Hartwig",
      "email": "o.hartwig@moselwal.de"
    },
    {
      "name": "Matthias Peltzer",
      "email": "matthias.peltzer@digitas.com"
    },
    {
      "name": "Michael Max Busch",
      "email": "m.busch@moselwal.de"
    },
    {
      "name": "Patrick Schriner",
      "email": "patrick.schriner@diemedialen.de"
    },
    {
      "name": "Christian Rath-Ulrich",
      "email": "christian.rath-ulrich@digitas.com"
    },
    {
      "name": "Thorsten Müller",
      "email": "thorsten.mueller@adesso.de"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-redis": "*",
    "b13/container": "3.1.10",
    "b13/host-variants": "1.3.0",
    "dasprid/enum": "^1.0.3",
    "derhansen/form_crshield": "2.0.1",
    "helhum/config-loader": "0.12.6",
    "helhum/typo3-console": "8.2.3",
    "ichhabrecht/content-defender": "3.5.3",
    "kitzberger/form-mailtext": "^3.0",
    "psr/event-dispatcher": "^1.0",
    "psr/http-factory": "^1.1.0",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^3.0.1",
    "symfony/console": "^7.2",
    "symfony/dependency-injection": "^7.2",
    "symfony/finder": "^7.2",
    "symfony/serializer": "^7.0",
    "symfony/serializer-pack": "^1.3",
    "symfony/yaml": "^7.2",
    "typo3/cms-backend": "^13.4",
    "typo3/cms-belog": "^13.4",
    "typo3/cms-beuser": "^13.4",
    "typo3/cms-core": "13.4.19",
    "typo3/cms-dashboard": "^13.4",
    "typo3/cms-extbase": "^13.4",
    "typo3/cms-extensionmanager": "^13.4",
    "typo3/cms-filelist": "^13.4",
    "typo3/cms-filemetadata": "^13.4",
    "typo3/cms-fluid": "^13.4",
    "typo3/cms-fluid-styled-content": "^13.4",
    "typo3/cms-form": "^13.4",
    "typo3/cms-frontend": "^13.4",
    "typo3/cms-impexp": "^13.4",
    "typo3/cms-info": "^13.4",
    "typo3/cms-install": "^13.4",
    "typo3/cms-linkvalidator": "^13.4",
    "typo3/cms-lowlevel": "^13.4",
    "typo3/cms-opendocs": "^13.4",
    "typo3/cms-recycler": "^13.4",
    "typo3/cms-redirects": "^13.4",
    "typo3/cms-reports": "^13.4",
    "typo3/cms-rte-ckeditor": "^13.4",
    "typo3/cms-scheduler": "^13.4",
    "typo3/cms-seo": "^13.4",
    "typo3/cms-setup": "^13.4",
    "typo3/cms-sys-note": "^13.4",
    "typo3/cms-tstemplate": "^13.4",
    "typo3/cms-viewpage": "^13.4",
    "typo3/cms-workspaces": "^13.4",
    "typo3fluid/fluid": "^4.4.3",
    "wapplersystems/multisite-belogin": "13.0.0",
    "wapplersystems/save_and_close": "13.0.1"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.47.0",
    "helmich/typo3-typoscript-lint": "^3.3.0",
    "phpmd/phpmd": "^2.13",
    "shipmonk/composer-dependency-analyser": "^1.8",
    "ssch/typo3-rector": "^3.5",
    "typo3/coding-standards": "^0.8",
    "typo3/testing-framework": "^8.2"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://git.gsb-itzbund.de/api/v4/group/6/-/packages/composer/packages.json"
    }
  ],
  "autoload": {
    "psr-4": {
      "ITZBund\\GsbCore\\": "Classes/",
      "ITZBund\\GsbCore\\Tests\\": "Tests/"
    }
  },
  "config": {
    "allow-plugins": true,
    "gitlab-domains": [
      "gitlab.itzbund.de"
    ],
    "gitlab-protocol": "https",
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "4.x-dev"
    },
    "itzbund/gsb-core": {
      "isSitePackage": true
    },
    "typo3/cms": {
      "cms-package-dir": "{$vendor-dir}/typo3/cms",
      "extension-key": "gsb_core",
      "web-dir": "vendor"
    }
  },
  "scripts": {
    "composer:normalize": "@composer normalize --dry-run --no-check-lock",
    "composer:normalize:fix": "@composer normalize --no-check-lock",
    "composer:psr-verify": "@composer dumpautoload --optimize --strict-psr",
    "composer:validate": "@composer validate --strict",
    "json:lint": "find . ! -path '*vendor/*' ! -path '*Build/*' ! -path '*node_modules/*' -name '*.json' | xargs -r php vendor/bin/jsonlint -q",
    "phpcs:analyze": "php vendor/bin/php-cs-fixer fix --config .php-cs-fixer.dist.php -v --dry-run --using-cache no --diff",
    "phpcs:fix": "php vendor/bin/php-cs-fixer fix --config .php-cs-fixer.dist.php -v --using-cache no --diff",
    "phpmd:analyze": "php vendor/bin/phpmd Classes/ text gsb11.ruleset.xml --baseline-file phpmd.baseline.xml",
    "phpmd:generatebaseline": "php vendor/bin/phpmd Classes/ text gsb11.ruleset.xml --baseline-file phpmd.baseline.xml --generate-baseline",
    "phpstan:analyze": "php vendor/bin/phpstan analyse --no-progress",
    "phpstan:generatebaseline": "php vendor/bin/phpstan analyse --no-progress --generate-baseline",
    "phpunit:test": "@php vendor/bin/phpunit --bootstrap vendor/autoload.php --no-configuration Tests/Unit",
    "typoscript:lint": "php vendor/bin/typoscript-lint -c .typoscript-lint.yml --ansi -n --fail-on-warnings -vvv Configuration/TypoScript",
    "yaml:lint": "rm -rf Build/node_modules && find . -not -path './vendor/*' -not -path './Build/*' -name '*.yaml' -o -name '*.yml' | xargs -r php vendor/bin/yaml-lint"
  },
  "scripts-descriptions": {
    "composer:normalize": "Normalize composer.json",
    "composer:normalize:fix": "Normalize composer.json and fix it",
    "composer:psr-verify": "Verify PSR-4 autoloading",
    "composer:validate": "Validate composer.json",
    "json:lint": "Lint JSON files",
    "phpcs:analyze": "Analyze code with PHP Code Sniffer (TYPO3 Ruleset)",
    "phpcs:fix": "Fix code with PHP Code Sniffer (TYPO3 Ruleset)",
    "phpmd:analyze": "Analyze code with PHPMD",
    "phpmd:generatebaseline": "Generate baseline for PHPMD",
    "phpstan:analyze": "Analyze code with PHPStan",
    "phpstan:generatebaseline": "Generate baseline for PHPStan",
    "phpunit:test": "Run unit tests",
    "typoscript:lint": "Lint TypoScript files",
    "yaml:lint": "Lint YAML files"
  }
}
